.page { padding:28rpx; background:radial-gradient(ellipse at top,#252452,#0b1024 65%); min-height:100vh; }.heading { font-size:38rpx; font-weight:bold; color:#eee6ff; }.summary { color:#a9afd4; font-size:22rpx; margin:12rpx 0 26rpx; }.grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14rpx; }.entry { min-height:300rpx; border-radius:16rpx; padding:14rpx; border:1rpx solid #68718d; background:linear-gradient(150deg,#29334c,#11172b); display:flex; flex-direction:column; align-items:center; box-sizing:border-box; color:#c8d0e7; }.entry.rare { border-color:#68a9e8; background:linear-gradient(150deg,#173a60,#11172b); color:#82c4ff; }.entry.epic { border-color:#b278e4; background:linear-gradient(150deg,#48256b,#11172b); color:#d49aff; }.entry.legendary { border-color:#e7bd68; background:linear-gradient(150deg,#70451b,#16152b); color:#ffd978; }.locked { filter:grayscale(1); opacity:.55; }.symbol { font-size:58rpx; text-shadow:0 0 20rpx currentColor; margin:8rpx 0; }.name { font-size:22rpx; font-weight:bold; text-align:center; color:#fff; }.rarity { font-size:18rpx; margin:6rpx 0; }.stats { font-size:19rpx; color:#fff; }.counts { font-size:16rpx; color:#c2c7df; margin-top:6rpx; }.duplicates { font-size:16rpx; color:#f0cb83; margin-top:4rpx; }.desc { font-size:16rpx; text-align:center; color:#aeb7d7; margin-top:8rpx; line-height:1.35; }.back { margin-top:30rpx; color:#eee; background:#353064; border:1rpx solid #7161b5; border-radius:14rpx; }
