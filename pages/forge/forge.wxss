.page { padding:28rpx; min-height:100vh; background:radial-gradient(ellipse at top,#30204c,#0b1024 65%); }.heading { font-size:38rpx; font-weight:bold; color:#f2e6ff; }.intro { color:#aeb2d5; font-size:22rpx; line-height:1.5; margin:14rpx 0 28rpx; }.list { display:flex; flex-direction:column; gap:14rpx; }.forge-row { display:flex; align-items:center; gap:16rpx; padding:18rpx; border:1rpx solid #5d6688; border-radius:18rpx; background:linear-gradient(100deg,#242b4a,#11172b); }.forge-row.rare { border-color:#579bdf; }.forge-row.epic { border-color:#a66bd7; }.forge-row.legendary { border-color:#dcb65f; }.card-symbol { width:82rpx; height:82rpx; flex-shrink:0; display:flex; align-items:center; justify-content:center; border-radius:16rpx; background:#34365e; color:#e3d4ff; font-size:48rpx; box-shadow:inset 0 0 18rpx #9e79ff44; }.pulse { animation:pulse .85s ease-in-out infinite alternate; }.info { flex:1; min-width:0; }.name { color:#fff; font-size:25rpx; font-weight:bold; }.rarity,.shiny-count { color:#abb4d6; font-size:18rpx; margin-top:4rpx; }.progress { height:8rpx; border-radius:10rpx; background:#080d1e; margin-top:10rpx; overflow:hidden; }.progress-fill { height:100%; background:linear-gradient(90deg,#7760d8,#f0d38a); }.forge-btn { width:112rpx; margin:0; font-size:22rpx; border-radius:12rpx; color:#fff; flex-shrink:0; }.ready { background:linear-gradient(145deg,#9b6bcb,#6b439c); border:1rpx solid #d2a4ff; }.disabled { background:#252b42; color:#68718f; }.success-panel { position:fixed; inset:0; z-index:5; background:#080a19ee; display:flex; flex-direction:column; align-items:center; justify-content:center; animation:appear .4s ease-out; }.success-spark { font-size:72rpx; color:#ffdf8d; text-shadow:0 0 40rpx #ffc45a; animation:spark 1s infinite alternate; }.success-title { color:#f4e8ff; font-size:34rpx; font-weight:bold; margin-top:24rpx; }.success-name { color:#ffdf8d; font-size:46rpx; font-weight:bold; margin-top:16rpx; text-shadow:0 0 28rpx #ffc45a; }.success-sub { color:#999dc5; font-size:18rpx; letter-spacing:4rpx; margin-top:16rpx; }.empty { color:#929cc4; text-align:center; margin-top:60rpx; font-size:24rpx; }
@keyframes pulse { from { transform:scale(.94) rotate(-3deg); box-shadow:0 0 8rpx #a77aff; } to { transform:scale(1.08) rotate(3deg); box-shadow:0 0 30rpx #ffd879; } } @keyframes appear { from { opacity:0; transform:scale(.8); } to { opacity:1; transform:scale(1); } } @keyframes spark { from { transform:rotate(-5deg) scale(.9); } to { transform:rotate(5deg) scale(1.1); } }
