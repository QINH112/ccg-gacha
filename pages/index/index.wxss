.page { padding: 30rpx 28rpx 50rpx; min-height: 100vh; box-sizing: border-box; background: radial-gradient(ellipse at 50% 20%, #252452 0, #10142b 45%, #090d1c 100%); }
.topbar { display:flex; justify-content:space-between; align-items:center; }
.eyebrow { color:#9b91ff; font-size:18rpx; letter-spacing:4rpx; }
.title { font-size:48rpx; font-weight:800; margin-top:8rpx; color:#f4f0ff; text-shadow:0 0 20rpx #8d6cff; }
.subtitle { font-size:22rpx; color:#a9afd4; margin-top:8rpx; }
.stats { display:flex; gap:14rpx; }
.stat { background:#1b2040; border:1rpx solid #3d3b72; border-radius:16rpx; padding:12rpx 18rpx; display:flex; flex-direction:column; align-items:center; }
.stat-num { color:#f3d88a; font-size:28rpx; font-weight:bold; }.stat-label { color:#969dc4; font-size:18rpx; }
.altar { position:relative; overflow:hidden; margin-top:36rpx; border-radius:28rpx; height:440rpx; border:2rpx solid #51468f; background:linear-gradient(155deg,#292457,#11182f 65%,#17102f); display:flex; flex-direction:column; align-items:center; justify-content:center; box-shadow:inset 0 0 50rpx #6655ba22,0 12rpx 35rpx #0005; }
.orb { position:absolute; width:280rpx; height:280rpx; border-radius:50%; filter:blur(3rpx); opacity:.24; }.orb-one { background:#8b62ff; top:-80rpx; left:-60rpx; }.orb-two { background:#47cfff; right:-80rpx; bottom:-100rpx; }
.rune { font-size:120rpx; color:#d8c8ff; text-shadow:0 0 40rpx #a17bff; animation:glow 2.5s infinite alternate; }
.altar-title { font-size:32rpx; font-weight:bold; color:#e6ddff; margin-top:8rpx; }.altar-desc { color:#a9a9d4; font-size:22rpx; margin-top:10rpx; }
.rates { display:flex; gap:12rpx; margin-top:28rpx; z-index:1; }.rate-item { display:flex; flex-direction:column; align-items:center; padding:10rpx 16rpx; border-radius:12rpx; background:#0b1026aa; border:1rpx solid #48456e; }.rate-name { font-size:20rpx; }.rate-value { font-size:23rpx; font-weight:bold; margin-top:4rpx; }.common .rate-name,.common .rate-value { color:#c5c9d9; }.rare .rate-name,.rare .rate-value { color:#70baff; }.epic .rate-name,.epic .rate-value { color:#ce8aff; }.legendary .rate-name,.legendary .rate-value { color:#ffd779; }
.guarantee { text-align:center; color:#e7cc8b; font-size:22rpx; margin:28rpx 0 18rpx; }
.draw-actions { display:flex; gap:14rpx; }.draw-btn { flex:1; height:112rpx; border-radius:18rpx; display:flex; flex-direction:column; justify-content:center; align-items:center; color:#fff; line-height:1.3; box-shadow:0 8rpx 18rpx #0004; }.single { background:linear-gradient(145deg,#4a5ca4,#2b3268); border:1rpx solid #7189d8; }.five { background:linear-gradient(145deg,#704ba8,#442b7b); border:1rpx solid #b38bff; }.ten { background:linear-gradient(145deg,#b08342,#765025); border:1rpx solid #f0ca79; }.btn-title { font-size:30rpx; font-weight:bold; }.btn-sub { font-size:18rpx; opacity:.85; margin-top:5rpx; }
.nav-actions { display:flex; gap:14rpx; margin-top:22rpx; }.nav-btn { flex:1; background:#171d39; border:1rpx solid #3c4776; color:#cdd5ff; border-radius:14rpx; font-size:24rpx; }.reset-btn { margin-top:16rpx; background:transparent; color:#727b9f; font-size:20rpx; }
.result-mask { position:fixed; inset:0; z-index:10; background:#050714eF; display:flex; align-items:center; justify-content:center; padding:24rpx; }.result-panel { width:100%; max-height:90vh; overflow-y:auto; background:linear-gradient(160deg,#1d2147,#0d1329); border:1rpx solid #6554a4; border-radius:26rpx; padding:24rpx; box-sizing:border-box; box-shadow:0 0 60rpx #7357d955; }.result-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:22rpx; }.result-title { font-size:32rpx; font-weight:bold; color:#f0e5ff; }.result-close { color:#a8afd4; font-size:48rpx; padding:0 10rpx; }.result-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:12rpx; }.result-card-wrap { height:280rpx; perspective:1000rpx; }.card-flipper { position:relative; width:100%; height:100%; transform-style:preserve-3d; transition:transform .65s cubic-bezier(.2,.8,.2,1); }.card-flipper.revealed { transform:rotateY(180deg); }.card-face { position:absolute; inset:0; backface-visibility:hidden; border-radius:12rpx; overflow:hidden; }.card-back { display:flex; flex-direction:column; justify-content:center; align-items:center; background:radial-gradient(circle,#423d84,#151b38); border:2rpx solid #7772c8; color:#d7cbff; font-size:60rpx; }.back-caption { font-size:12rpx; letter-spacing:2rpx; }.card-front { transform:rotateY(180deg); padding:5rpx; box-sizing:border-box; }.card-frame { height:100%; border:2rpx solid currentColor; border-radius:9rpx; display:flex; flex-direction:column; align-items:center; padding:7rpx; box-sizing:border-box; background:linear-gradient(160deg,#272e51,#10172b); }.card-front.common { color:#c4cadb; }.card-front.rare { color:#78baff; background:linear-gradient(160deg,#153b65,#11172b); }.card-front.epic { color:#d39aff; background:linear-gradient(160deg,#48256d,#11172b); }.card-front.legendary { color:#ffd978; background:linear-gradient(160deg,#70451b,#16152b); }.card-element { font-size:30rpx; }.card-name { font-size:18rpx; font-weight:bold; text-align:center; margin-top:2rpx; color:#fff; }.card-art { flex:1; display:flex; align-items:center; justify-content:center; font-size:60rpx; text-shadow:0 0 20rpx currentColor; }.card-desc { font-size:12rpx; text-align:center; color:#bfc4df; line-height:1.2; }.card-stats { display:flex; width:100%; justify-content:space-between; font-size:18rpx; font-weight:bold; margin-top:4rpx; color:#fff; }.card-rarity { font-size:12rpx; text-transform:uppercase; margin-top:4rpx; }.result-note { text-align:center; font-size:21rpx; color:#969fc7; margin:20rpx 0; }.confirm-btn { background:linear-gradient(90deg,#6652b2,#a17bda); color:white; border-radius:16rpx; font-weight:bold; }
@keyframes glow { from { transform:scale(.96); opacity:.75; } to { transform:scale(1.04); opacity:1; } }
