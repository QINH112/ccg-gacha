<view class="page">
  <view class="topbar">
    <view>
      <view class="eyebrow">ASTRAL SUMMON · 星界秘仪</view>
      <view class="title">星界召唤</view>
      <view class="subtitle">在无垠星海中，邂逅你的命运卡牌</view>
    </view>
    <view class="stats">
      <view class="stat"><text class="stat-num">{{totalDraws}}</text><text class="stat-label">累计召唤</text></view>
      <view class="stat"><text class="stat-num">{{inventoryCount}}</text><text class="stat-label">卡牌库存</text></view>
    </view>
  </view>

  <view class="altar">
    <view class="orb orb-one"></view><view class="orb orb-two"></view>
    <view class="rune">✧</view>
    <view class="altar-title">星门已开启</view>
    <view class="altar-desc">召唤星界伙伴，构筑你的传奇</view>
    <view class="rates">
      <view wx:for="{{rates}}" wx:key="key" class="rate-item {{item.key}}">
        <text class="rate-name">{{item.label}}</text><text class="rate-value">{{item.rate}}%</text>
      </view>
    </view>
  </view>

  <view class="guarantee">✦ {{guaranteeText}} ✦</view>

  <view class="draw-actions">
    <button class="draw-btn single" bindtap="onSingle"><text class="btn-title">单抽</text><text class="btn-sub">召唤 ×1</text></button>
    <button class="draw-btn five" bindtap="onFive"><text class="btn-title">五连抽</text><text class="btn-sub">召唤 ×5</text></button>
    <button class="draw-btn ten" bindtap="onTen"><text class="btn-title">十连抽</text><text class="btn-sub">召唤 ×10 · 保底</text></button>
  </view>

  <view class="nav-actions">
    <button class="nav-btn" bindtap="goCollection">▣ 卡牌图鉴 / 库存</button>
    <button class="nav-btn" bindtap="goForge">✧ 闪耀合成</button>
  </view>
  <button class="reset-btn" bindtap="resetLocalSave">重置本地存档</button>

  <view wx:if="{{showResults}}" class="result-mask">
    <view class="result-panel">
      <view class="result-heading">
        <view class="result-title">{{recentLabel}}</view>
        <view class="result-close" bindtap="closeResults">×</view>
      </view>
      <view class="result-grid">
        <view wx:for="{{resultList}}" wx:key="index" class="result-card-wrap">
          <view class="card-flipper {{item.revealed ? 'revealed' : ''}}">
            <view class="card-face card-back"><text>✧</text><text class="back-caption">ASTRAL</text></view>
            <view class="card-face card-front {{item.card.rarity}}">
              <view class="card-frame">
                <view class="card-element">{{item.card.element}}</view>
                <view class="card-name">{{item.card.name}}</view>
                <view class="card-art">{{item.card.element}}</view>
                <view class="card-desc">{{item.card.description}}</view>
                <view class="card-stats"><text>⚔ {{item.card.attack}}</text><text>♥ {{item.card.health}}</text></view>
                <view class="card-rarity">{{item.card.rarity}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="result-note">卡牌已自动存入本地库存</view>
      <button class="confirm-btn" bindtap="closeResults">收下卡牌</button>
    </view>
  </view>
</view>
